# Server Config
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Session Security
SESSION_SECRET=a_very_long_and_warm_cozy_secret_phrase_change_me_please

# Invite System
INITIAL_INVITE_CODE=COZY_SNEZHOK

# Comma-separated browser origins allowed in production.
# Example: https://merchedits-server.tail9e378f.ts.net
ALLOWED_ORIGINS=

# Storage Limits
# 100MB in bytes = 104857600
MAX_FILE_SIZE=104857600

# Database
DATABASE_URL=file:./data/app.db

# TURN server configurations (for external WebRTC connections)
# Comma-separated STUN servers. Leave empty only if you use TURN or same-LAN/direct peers.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# Set to true if deploying with coturn
USE_TURN=false
TURN_URL=turn:your-server-ip:3478
TURN_USERNAME=cozyuser
TURN_CREDENTIAL=cozypassword
