# Server Config
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Session Security
SESSION_SECRET=a_very_long_and_warm_cozy_secret_phrase_change_me_please

# Invite System
INITIAL_INVITE_CODE=COZY_SNEZHOK

# Storage Limits
# 10GB in bytes = 10737418240
MAX_FILE_SIZE=10737418240

# Database
DATABASE_URL=file:./data/app.db

# TURN server configurations (for external WebRTC connections)
# Set to true if deploying with coturn
USE_TURN=false
TURN_URL=turn:your-server-ip:3478
TURN_USERNAME=cozyuser
TURN_CREDENTIAL=cozypassword
