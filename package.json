{
  "name": "snezhok-workspace",
  "license": "GPL-3.0-or-later",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,web --prefix-colors blue,magenta \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/server",
    "db:generate": "npm run db:generate --workspace=apps/server",
    "db:migrate": "npm run db:migrate --workspace=apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
