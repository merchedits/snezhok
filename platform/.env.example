NODE_ENV=development
IMAGE_TAG=replace-with-public-source-revision
POSTGRES_PASSWORD=replace-with-high-entropy-owner-db-password
HOST=0.0.0.0
PORT=3000
APP_ORIGINS=http://localhost:5173
PUBLIC_API_PREFIX=/api/v1
DATABASE_URL=postgresql://snezhok:snezhok@localhost:5432/snezhok
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=snezhok
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_MAX=5
# Production uses distinct non-superuser passwords for the API and media
# worker. URI-reserved characters are safe because connections use fields.
API_DATABASE_PASSWORD=replace-with-high-entropy-api-db-password
WORKER_DATABASE_PASSWORD=replace-with-high-entropy-worker-db-password
STORAGE_ROOT=./data
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=365
# Administrators are promoted only with the explicit existing-user-ID bootstrap
# command documented in docs/ADMINISTRATION.md.
MAX_UPLOAD_BYTES=2147483648
UPLOAD_CHUNK_BYTES=4194304
EVENT_RETENTION_DAYS=30
ORPHAN_MEDIA_RETENTION_DAYS=7
RELIABILITY_CLEANUP_INTERVAL_MINUTES=15
PUSH_DELIVERY_RETENTION_DAYS=7
USE_X_ACCEL=false
INTERNAL_MEDIA_PREFIX=/_protected-media/
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_CONTROL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
CALL_PHANTOM_TIMEOUT_SECONDS=120
ANDROID_APK_PATH=
ANDROID_RELEASE_MANIFEST_PATH=
