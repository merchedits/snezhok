NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_ORIGINS=http://localhost:5173
PUBLIC_API_PREFIX=/api/v1
DATABASE_URL=postgresql://snezhok:snezhok@localhost:5432/snezhok
DATABASE_POOL_MAX=5
STORAGE_ROOT=./data
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=365
MAX_UPLOAD_BYTES=2147483648
UPLOAD_CHUNK_BYTES=4194304
EVENT_RETENTION_DAYS=30
ORPHAN_MEDIA_RETENTION_DAYS=7
RELIABILITY_CLEANUP_INTERVAL_MINUTES=15
PUSH_DELIVERY_RETENTION_DAYS=7
USE_X_ACCEL=false
INTERNAL_MEDIA_PREFIX=/_protected-media/
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
ANDROID_APK_PATH=
