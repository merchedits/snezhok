[Unit]
Description=Replay-verify the encrypted Snezhok PITR WAL chain
RequiresMountsFor=/var/backups/snezhok
After=docker.service snezhok-pitr-base.service
Wants=docker.service

[Service]
Type=oneshot
User=merchedits
Group=merchedits
EnvironmentFile=/etc/snezhok/maintenance.env
Environment=MAINTENANCE_LOCK_ROOT=/var/lib/snezhok-maintenance
ExecStart=/usr/bin/bash /home/merchedits/sites/snezhok-v3/platform/scripts/maintenance/verify-pitr-restore.sh
StateDirectory=snezhok-maintenance
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/snezhok /var/lib/snezhok-maintenance
TimeoutStartSec=6h
