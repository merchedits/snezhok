[Unit]
Description=Prune unreferenced Snezhok storage and expired Android releases
Documentation=file:///home/merchedits/sites/snezhok-v3/platform/docs/OPERATIONS.md
After=docker.service snezhok-backup.service
Wants=docker.service

[Service]
Type=oneshot
User=merchedits
Group=merchedits
UMask=0077
WorkingDirectory=/home/merchedits/sites/snezhok-v3/platform
EnvironmentFile=/etc/snezhok/maintenance.env
Environment=MAINTENANCE_LOCK_ROOT=/var/lib/snezhok-maintenance
StateDirectory=snezhok-maintenance
StateDirectoryMode=0700
ExecStart=/usr/bin/bash /home/merchedits/sites/snezhok-v3/platform/scripts/maintenance/prune-storage.sh --apply
ExecStart=/usr/bin/node /home/merchedits/sites/snezhok-v3/platform/scripts/maintenance/prune-releases.mjs --apply
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/merchedits/sites/snezhok-v3/platform/data-v3 /home/merchedits/sites/snezhok-v3/platform/runtime/releases
TimeoutStartSec=2h
