[Unit]
Description=Snezhok production dependency and recovery health check
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=merchedits
Group=merchedits
EnvironmentFile=/etc/snezhok/maintenance.env
ExecStart=/usr/bin/bash /home/merchedits/sites/snezhok-v3/platform/scripts/monitoring/production-health.sh
StateDirectory=snezhok-maintenance
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/snezhok-maintenance
TimeoutStartSec=2min
