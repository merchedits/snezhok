{
  "name": "@snezhok/api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --workspace=@snezhok/contracts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --workspace=@snezhok/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace=@snezhok/contracts",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/commands/migrate.ts",
    "import:legacy": "tsx src/commands/import-legacy.ts",
    "import:legacy:prod": "node dist/commands/import-legacy.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@snezhok/contracts": "*",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.6.2",
    "file-type": "^21.0.0",
    "jose": "^6.1.0",
    "livekit-server-sdk": "^2.15.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
