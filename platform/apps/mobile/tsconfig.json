{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@snezhok/contracts": ["../../packages/contracts/src/index.ts"],
      "@snezhok/game-engine": ["../../packages/game-engine/src/index.ts"]
    }
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts", "src/**/*.tsx", "app.config.ts"]
}
